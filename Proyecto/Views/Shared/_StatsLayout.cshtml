@*
    Partial View para el Layout de las paginas de Stats.
*@
@{
}
<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Stats" asp-action="Index">Stats</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                @* Visualizacion en caso de que la pagina actual sea el indice u otra pagina accesible desde Stats *@
                <li class="nav-item @((ViewBag.SecView == "Stats_Index") ? "active": "")">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Stats" asp-action="Index">Stats</a>
                </li>
                <li class="nav-item @((ViewBag.SecView == "Stats_Saves") ? "active" : "")">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Stats" asp-action="Saves">Saves</a>
                </li>
            </ul>
        </div>
    </div>
</nav>