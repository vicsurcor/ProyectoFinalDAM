@using Proyecto.Models.User;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var timePlayed = UserContent.DeconstructTime(Model.UserContent.TimePlayed);
}
@model UserViewModel
@if (ViewBag.SecondaryLayout != null)
{
    @section SecondaryLayout {
        <partial name="@(ViewBag.SecondaryLayout)"></partial>
    }
}

<h2>@(Model.User.UserName)</h2>

<div class="stats-content">
    <div class="stat">
        @Html.LabelFor(m => timePlayed, "Time played: ", new {@class = "stat-label"})
        @Html.DisplayFor(m => timePlayed)
    </div>
    <div class="stat">
        @Html.LabelFor(m => m.UserContent.CharacterLevel, "Character level: ", new { @class = "stat-label" })
        @Html.DisplayFor(m => m.UserContent.CharacterLevel)
    </div>
    <div class="stat">
        @Html.LabelFor(m => m.UserContent.EnemiesDefeated, "Enemies defeated: ", new { @class = "stat-label" })
        @Html.DisplayFor(m => m.UserContent.EnemiesDefeated)
    </div>
    <div class="stat">
        @Html.LabelFor(m => m.UserContent.LevelsCleared, "Levels cleared: ", new { @class = "stat-label" })
        @Html.DisplayFor(m => m.UserContent.LevelsCleared)
    </div>
    <div class="stat">
        @Html.LabelFor(m => m.UserContent.Deaths, "Player deaths: ", new { @class = "stat-label" })
        @Html.DisplayFor(m => m.UserContent.Deaths)
    </div>
    <div class="stat">
        @Html.LabelFor(m => m.UserContent.FirstPlayed, "First played: ", new { @class = "stat-label" })
        @Html.DisplayFor(m => m.UserContent.FirstPlayed)
    </div>
    <div class="stat">
        @Html.LabelFor(m => m.UserContent.LastPlayed, "Last Played: ", new { @class = "stat-label" })
        @Html.DisplayFor(m => m.UserContent.LastPlayed)
    </div>
</div>
