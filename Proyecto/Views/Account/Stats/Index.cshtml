@using Proyecto.Models.User;
@* View para la Visualizacion de los datos guardados del Usuario *@
@{
    
    UserContent data = UserContent.UpdateContent(Model.UserContent);
    var timePlayed = UserContent.DeconstructTime(data.TimePlayed);
}
@model UserViewModel
@if (ViewBag.SecondaryLayout != null)
{
    @section SecondaryLayout {
        <partial name="@(ViewBag.SecondaryLayout)"></partial>
    }
}
<link rel="stylesheet" href="~/Views/Account/Stats/Index.cshtml.css" asp-append-version="true" />

<h2>@(Model.User.UserName)</h2>

<div class="stats-content">
    <div class="stat">
        <div class="label-div">
            @Html.LabelFor(m => timePlayed, "Time played: ", new {@class = "stat-label"})
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => timePlayed)
            </div>
        </div>
    </div>
    <div class="stat">
        <div class="label-div">
            @Html.LabelFor(m => data.CharacterLevel, "Character level: ", new { @class = "stat-label" })
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => data.CharacterLevel)
            </div>
        </div>
    </div>
    <div class="stat">
        <div class=label-div>
            @Html.LabelFor(m => data.EnemiesDefeated, "Enemies defeated: ", new { @class = "stat-label" })
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => data.EnemiesDefeated)
            </div>
        </div>
    </div>
    <div class="stat">
        <div class=label-div>
            @Html.LabelFor(m => data.LevelsCleared, "Levels cleared: ", new { @class = "stat-label" })
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => data.LevelsCleared)
            </div>
        </div>
    </div>
    <div class="stat">
        <div class=label-div>
            @Html.LabelFor(m => data.Deaths, "Player deaths: ", new { @class = "stat-label" })
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => data.Deaths)
            </div>
        </div>
    </div>
    <div class="stat">
        <div class=label-div>
            @Html.LabelFor(m => m.UserContent.FirstPlayed, "First played: ", new { @class = "stat-label" })
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => m.UserContent.FirstPlayed)
            </div>
        </div>
    </div>
    <div class="stat">
        <div class=label-div>
            @Html.LabelFor(m => data.LastPlayed, "Last Played: ", new { @class = "stat-label" })
        </div>
        <hr />
        <div class=display-div>
            <div class="stat-display">
                @Html.DisplayFor(m => data.LastPlayed)
           </div>
       </div>
    </div>
</div>
