@using Proyecto.Models.User;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model UserContent
@if (ViewBag.SecondaryLayout != null)
{
    @section SecondaryLayout {
        <partial name="@(ViewBag.SecondaryLayout)"></partial>
    }
}

<div class="saves-content">
    @foreach (var save in Model.Saves)
    {
        <div class="save">
            @Html.LabelFor(m => save, "Save: ",new {@class = "save-label"})   
            <br />
            @Html.ActionLink(save.Value.Name, "")
        </div>
    }
</div>