@using Proyecto.Models.User;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model UserContent
@if (ViewBag.SecondaryLayout != null)
{
    @section SecondaryLayout {
        <partial name="@(ViewBag.SecondaryLayout)"></partial>
    }
}

<div class="saves-content">
    @foreach (var save in Model.Saves)
    {
        <div class="save">
            @Html.LabelFor(m => save, "Save: " + save.Value.Name, new {@class = "save-label"})   
            <br />
            @* <a asp-action="DownloadSaveFile" asp-route-saveId="@save.Value.Id">Download @save.Value.Name</a> *@

            <a href="/download/@save.Value.Id">Download @save.Value.Name</a>

        </div>
    }
</div>