@using Proyecto.Models.User;

@{
    ViewData["Title"] = "Register";
}

@model UserViewModel;
<head>
    <styles>
        <link href="~/css/Account.css" rel="stylesheet" />
    </styles>
</head>


<h2>Register</h2>
<hr />

<form method="post" action="/Account/Register">
    <div class="form-group">
        @Html.LabelFor(m => m.User.UserName, "Username: ")
        @Html.TextBoxFor(m => m.User.UserName, new { @class = "form-control", placeholder = "Insert your username here. " })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.User.UserEmail, "Email: ")
        @Html.TextBoxFor(m => m.User.UserEmail, new { @class = "form-control", placeholder = "Insert your email here. " })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.User.Password, "Password: ")
        @Html.PasswordFor(m => m.User.Password, new { @class = "form-control", placeholder = "Insert your password here. " })
    </div>
    <br />
    @Html.ActionLink("Register", "Register", "AccountController", null, new { @class = "btn btn-primary" })
</form>