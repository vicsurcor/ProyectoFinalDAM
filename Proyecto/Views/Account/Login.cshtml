@using Proyecto.Models.User;
@* View para el formulario de Login del Usuario *@
@{
    ViewData["Title"] = "Login";
}
@model User;
<head>
    <styles>
        <link href="~/css/Account.css" rel="stylesheet" />
    </styles>
</head>

@* Visualizacion de Errores en la validacion del formulario*@
@Html.ValidationSummary("", new { @class = "shared-color validation-summary-errors" })

<h2>Login</h2>
<hr />

<form method="post" action="/Account/Login">

    <div class="form-group">
        @Html.LabelFor(m => m.UserName, "Username: ") @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
        <hr />
        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Insert your username here. "})
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Password, "Password: ") @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        <hr />
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Insert your password here. " })
    </div>
    <br />
    <input type="submit" value="Log in" class="btn btn-primary" />
</form>