@using Proyecto.Models.User;

@{
    ViewData["Title"] = "Login";
}
@model UserViewModel;
<head>
    <styles>
        <link href="~/css/Account.css" rel="stylesheet" />
    </styles>
</head>

<h2>Login</h2>
<hr />

<form method="post" action="/Account/Login">

    <div class="form-group">
        @Html.LabelFor(m => m.User.UserName, "Username: ")
        <hr />
        @Html.TextBoxFor(m => m.User.UserName, new { @class = "form-control", placeholder = "Insert your username here. "})
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.User.Password, "Password: ")
        <hr />
        @Html.PasswordFor(m => m.User.Password, new { @class = "form-control", placeholder = "Insert your password here. " })
    </div>
    <br />
    @Html.ActionLink("Log in", "Login", "AccountController", null, new {@class = "btn btn-primary"})
</form>